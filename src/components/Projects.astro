---
import Project from "./Project.astro";
const projects = [
  {
    repo: "dlasspro",
    desc: "一个开源的教师与白板通信平台.",
    icon: "i-twemoji-glowing-star",
  },
  {
    repo: "classworks-desktop",
    desc: "Classworks作业板桌面客户端.",
    icon: "i-twemoji-glowing-star",
  },
  {
    repo: "osgames",
    desc: "开源游戏项目！",
    icon: "i-twemoji-smiling-face-with-horns",
  },
  {
    repo: "osgame-dev",
    desc: "开源游戏开发者平台.",
    icon: "i-twemoji-hammer-and-wrench",
  },
];
---

<section>
  <h3 class="flex items-center mt-10 mb-4 font-semibold text-2xl tracking-tight">
    <span class="i-ri-code-box-line mr-2 text-brand-500"></span>
    <span class="flex-1">Projects</span>
    <a
      href="https://github.com/Super-Yyt"
      target="_blank"
      rel="noopener"
      class="op-50 hover:op-100 transition-opacity decoration-none text-current inline-flex items-center gap-1 text-sm font-normal"
    >
      <span>All</span>
      <span class="i-ri-arrow-right-up-line"></span>
    </a>
  </h3>
  <div class="grid gap-3.5 grid-cols-1 sm:grid-cols-2">
    {projects.map((project) => <Project {...project} />)}
  </div>
</section>
